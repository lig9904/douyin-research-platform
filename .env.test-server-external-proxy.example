# Copy to .env.test-server-external-proxy on the target host. The copied file
# is ignored by Git and must be mode 0600. This example is intentionally
# non-runnable until every CHANGE_ME value and example.invalid are replaced.
#
# This profile has no local Nginx/TLS proxy. A separate reverse-proxy machine
# terminates HTTPS and connects only to TEST_SERVER_WINDMILL_BIND_HOST:8000.

WINDMILL_VERSION=1.815.0
WINDMILL_IMAGE=ghcr.io/windmill-labs/windmill@sha256:9f175a520477de0cc24724e32f49104ab7aa2537fc684eb1353bf541c1f1142a
POSTGRES_IMAGE=postgres@sha256:86c951e05bf56c93d95d397747fb8820ac76cc3bedb78f43abd83eedbe3666ae

POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_HEX
POSTGRES_DB=windmill
RESEARCH_DB_NAME=douyin_research
RESEARCH_DB_USER=douyin_research
RESEARCH_DB_PASSWORD=CHANGE_ME_RESEARCH_HEX
WINDMILL_DATABASE_URL=postgres://postgres:CHANGE_ME_POSTGRES_HEX@postgres:5432/windmill?sslmode=disable

# This must be the public HTTPS URL served by the external reverse proxy.
WINDMILL_BASE_URL=https://research.example.invalid
WINDMILL_INTERNAL_URL=http://windmill_server:8000

# Replace this documentation-only RFC1918 example with the test server's
# actual private IPv4 address. 0.0.0.0, loopback and public addresses are
# rejected by the validator. Port 8000 is fixed so firewall rules stay narrow.
TEST_SERVER_WINDMILL_BIND_HOST=10.255.255.10
TEST_SERVER_WINDMILL_PORT=8000

# Provider credentials and writer/reviewer allowlists are created as Windmill
# Secret variables after identity setup. They never belong in this env file.
