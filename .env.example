# Copy to .env and replace every CHANGE_ME value before first startup.
#
# Generate URL-safe passwords, for example:
#   openssl rand -hex 24
#
# IMPORTANT:
# WINDMILL_DATABASE_URL repeats POSTGRES_PASSWORD.
# Keep passwords URL-safe (hex is recommended) so the URI does not require escaping.

WINDMILL_VERSION=1.815.0
WINDMILL_BIND_HOST=127.0.0.1
WINDMILL_PORT=8000

# Public/browser-facing URL. On a server, set the final HTTPS URL after reverse proxy is ready.
WINDMILL_BASE_URL=http://localhost:8000

# Docker-internal URL used by workers/jobs. Do not set this to localhost.
WINDMILL_INTERNAL_URL=http://windmill_server:8000

POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_HEX
POSTGRES_DB=windmill

WINDMILL_DATABASE_URL=postgres://postgres:CHANGE_ME_POSTGRES_HEX@postgres:5432/windmill?sslmode=disable

RESEARCH_DB_NAME=douyin_research
RESEARCH_DB_USER=douyin_research
RESEARCH_DB_PASSWORD=CHANGE_ME_RESEARCH_HEX

# These are intentionally blank in V1 bootstrap.
# Add third-party credentials later as Windmill Secrets, not Docker env vars:
# TIKHUB_API_KEY=
# VOLC_ASR_API_KEY=
# LLM_API_KEY=
